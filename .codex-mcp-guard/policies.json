        "source_file": "provenance-capture-tool.js",
        "cc_matchers": [
          "*"
        ],
        "invocation": "subprocess"
      },
      {
        "source_file": "dispatch.js",
        "cc_matchers": [
          "*"
        ],
        "invocation": "subprocess"
      }
    ],
    "apply_patch": []
  }
}
