{
  "schema": 1,
  "events": {
    "PreToolUse": {
      "dispatcher": { "matcher": "*", "timeout": 30 },
      "groups": [
        {
          "matcher": "Bash",
          "hooks": [
            { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-hook.js\"", "timeout": 5, "on_incomplete": "continue" }
          ]
        }
      ]
    }
  }
}
