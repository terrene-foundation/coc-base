{
  "schema": 1,
  "events": {
    "PreToolUse": {
      "dispatcher": {
        "matcher": "*",
        "timeout": 30
      },
      "groups": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ok-guard.js\"",
              "timeout": 5,
              "on_incomplete": "deny"
            },
            {
              "type": "command",
              "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/advise-hook.js\"",
              "timeout": 5,
              "on_incomplete": "continue"
            },
            {
              "type": "command",
              "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ok-exit.js\"",
              "timeout": 5,
              "on_incomplete": "deny"
            }
          ]
        }
      ]
    }
  }
}
