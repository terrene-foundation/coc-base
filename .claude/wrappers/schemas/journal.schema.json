{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coc-journal",
  "type": "object",
  "properties": {
    "phase": {
      "type": "string",
      "const": "journal"
    },
    "execution_mode": {
      "type": "string",
      "const": "headless-with-gates"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "needs_input",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Concrete outcome; do not call unrun or pending work complete"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "command",
              "observation",
              "receipt"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "description": "Actual source, command, observation or receipt"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unrun",
              "observed"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "description": "Observed result and limits"
          }
        },
        "required": [
          "kind",
          "reference",
          "outcome",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Actual artifact path"
          },
          "change": {
            "type": "string",
            "enum": [
              "created",
              "updated",
              "read"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Actual artifact purpose"
          }
        },
        "required": [
          "path",
          "change",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "Failure identity"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Concrete failure"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "required_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable input identifier"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Exact missing information or human gate"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why execution cannot continue"
          }
        },
        "required": [
          "id",
          "prompt",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Concrete next action within existing authority"
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Knowledge artifact actually read or written"
          }
        },
        "repo_class": {
          "type": "string",
          "enum": [
            "coc-source",
            "coc-use-template",
            "coc-build",
            "coc-project",
            "unknown"
          ]
        },
        "routing": {
          "type": "string",
          "minLength": 1,
          "description": "Actual class-derived routing; coc-source codify creates no upstream proposal"
        },
        "remaining_work": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Unfinished capture or verification"
          }
        }
      },
      "required": [
        "artifacts",
        "repo_class",
        "routing",
        "remaining_work"
      ],
      "additionalProperties": false,
      "description": "knowledge outcome; null only when blocked or awaiting input"
    }
  },
  "required": [
    "phase",
    "execution_mode",
    "status",
    "summary",
    "evidence",
    "outputs",
    "errors",
    "required_inputs",
    "next_actions",
    "result"
  ],
  "additionalProperties": false
}
